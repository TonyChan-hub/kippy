{
  "name": "@bear1210/kippy",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for Kippy CLI and related packages",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "lint": "npm run lint -w @bear1210/create-rn-template",
    "test": "npm run test --workspaces --if-present",
    "create-rn-template": "npm exec -w @bear1210/create-rn-template -- create-rn-template",
    "create-flutter-template": "npm exec -w @bear1210/create-flutter-template -- create-flutter-template",
    "setup-rn-android-env": "npm exec -w @bear1210/create-rn-template -- setup-rn-android-env",
    "setup-rn-ios-env": "npm exec -w @bear1210/create-rn-template -- setup-rn-ios-env",
    "check-mobile-env": "npm exec -w @bear1210/create-rn-template -- check-mobile-env",
    "native-kit": "npm exec -w @bear1210/native-kit -- native-kit",
    "zippy": "npm exec -w @bear1210/zippy -- zippy",
    "zippy:build": "npm run build -w @bear1210/zippy",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "version:create-rn-template": "npm version -w @bear1210/create-rn-template",
    "version:create-flutter-template": "npm version -w @bear1210/create-flutter-template",
    "version:zippy": "npm version -w @bear1210/zippy",
    "version:zippy-rn": "npm version -w @bear1210/zippy-rn"
  },
  "devDependencies": {
    "vitepress": "^1.6.4"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TonyChan-hub/kippy.git"
  }
}
