{
  "name": "@bear1210/zippy-rn",
  "version": "0.0.1",
  "description": "React Native debug probe SDK for Zippy desktop inspector (MMKV, SQLite, network, perf)",
  "license": "MIT",
  "type": "commonjs",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "react-native": "./src/index.ts",
  "source": "./src/index.ts",
  "files": [
    "lib",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "buffer": "^6.0.3",
    "react-native-tcp-socket": "^6.3.0"
  },
  "peerDependencies": {
    "react-native": ">=0.73.0",
    "react-native-mmkv": ">=2.0.0",
    "react-native-quick-sqlite": ">=8.0.0"
  },
  "peerDependenciesMeta": {
    "react-native-mmkv": {
      "optional": true
    },
    "react-native-quick-sqlite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.1.4",
    "react-native": "0.81.6",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TonyChan-hub/kippy.git",
    "directory": "packages/zippy_rn"
  },
  "keywords": [
    "react-native",
    "zippy",
    "debug",
    "probe",
    "mmkv",
    "sqlite"
  ]
}
