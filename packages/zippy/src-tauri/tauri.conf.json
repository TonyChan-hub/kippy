{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zippy",
  "version": "0.0.5",
  "identifier": "com.bear1210.zippy",
  "build": {
    "beforeDevCommand": "npm run dev:vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:vite",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Zippy",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "backgroundColor": "#0f1419"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI5Q0Q5NjMyNDlDMzIwQzUKUldURklNTkpNcGJOS1Y4NmVzQjZsZTlwMHFLZ3FnbENWWVFpOCtIb0ZwSm9oNkhOMU8zU3duRm8K",
      "endpoints": [
        "https://github.com/TonyChan-hub/kippy/releases/latest/download/latest.json"
      ]
    }
  }
}
